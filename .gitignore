# Local .terraform directories
**/.terraform/*
.terraform.lock.hcl.bak

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data & keys
# (terraform.tfvars.example does not match these patterns and stays tracked)
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# SSH private keys
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa
