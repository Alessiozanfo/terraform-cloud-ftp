project_id          = "cloud-ftp-zrtmt"
region              = "europe-west1"
cloud_ftp_server_id = "partner-sftp-srv"
bucket_name         = "cloud-ftp-zrtmt-storage"

# Limitazione opzionale degli IP sorgente (default 0.0.0.0/0 per accesso pubblico)
allowed_cidr_blocks = ["0.0.0.0/0"]

labels = {
  environment = "production"
  managed_by  = "terraform"
}

# Configurazione utenti SFTP nativi con chiavi SSH pubbliche
# (Identità collegate al ciclo di vita di Microsoft Entra ID tramite Cloud Identity)
ftp_users = {
  "partner_alpha" = {
    display_name  = "Partner Alpha Service Account"
    bucket_prefix = "incoming/partner_alpha"
    directory     = "/incoming"
    ssh_public_keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILFakePublicKeyExample1234567890 partner_alpha"
    ]
  },
  "partner_beta" = {
    display_name  = "Partner Beta Service Account"
    bucket_prefix = "incoming/partner_beta"
    directory     = "/incoming"
    ssh_public_keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILFakePublicKeyExample0987654321 partner_beta"
    ]
  }
}
