project_id  = "mio-progetto-gcp-12345"
region      = "europe-west1"
zone        = "europe-west1-b"
bucket_name = "mio-progetto-cloud-ftp-storage-2026"

# ==============================================================================
# 1. Configurazione Google Cloud FTP Nativo (IAM + SSH Keys)
# ==============================================================================
enable_gcp_iam_auth = true
cloud_ftp_server_id = "prod-managed-sftp"

iam_ftp_users = {
  "partner_alpha" = {
    display_name    = "Partner Alpha Service Account"
    ssh_public_keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILFakePublicKeyExample1234567890 partner_alpha"
    ]
  },
  "partner_beta" = {
    display_name    = "Partner Beta Service Account"
    ssh_public_keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILFakePublicKeyExample0987654321 partner_beta"
    ]
  }
}

# ==============================================================================
# 2. Configurazione Microsoft Entra ID (Username & Password delegata a Microsoft)
# ==============================================================================
enable_entra_id_auth = true

# Reperibili su portale Microsoft Entra ID (Azure AD) -> App Registrations
entra_tenant_id     = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
entra_client_id     = "yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"
entra_client_secret = "SegretoApplicativoEntraID_zzzzzzzzzz"
